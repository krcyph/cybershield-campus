# ─── CyberShield Campus — Backend Environment Variables ────────────────────────
# Copy this file to backend/.env and fill in your values.
# NEVER commit a real .env file to version control.

# Server
PORT=5000

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.ftqnohr.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — use a long, random string (minimum 32 characters)
JWT_SECRET=replace_this_with_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS — URL of the Next.js frontend (no trailing slash)
# This is also used as the allowed origin for Socket.io WebSocket connections.
FRONTEND_URL=http://localhost:3000

# ─── Socket.io ───────────────────────────────────────────────────────────────
# Socket.io shares the same port as the HTTP server — no separate port needed.
# Clients must authenticate via handshake.auth.token (a valid JWT).
# Room membership is derived from the verified JWT; clients cannot join rooms
# directly.  Two events are emitted:
#   incident:statusUpdated  — to the specific reporter's user room
#   advisory:published      — broadcast to all connected students
# No additional environment variables are required; Socket.io uses
# FRONTEND_URL for CORS and JWT_SECRET for token verification.

# Admin seed credentials
# Used ONLY by the seed:admin script. Never exposed through any API endpoint.
ADMIN_EMAIL=admin@college.edu.in
ADMIN_PASSWORD=Change_This_Strong_Admin_Password_123!
ADMIN_FULL_NAME=Campus IT Admin
