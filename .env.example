# ─── CyberShield Campus — Frontend Environment Variables ───────────────────────
# Copy this file to .env.local and fill in your values.
# Do NOT commit real .env.local to version control.

# Backend API base URL — REQUIRED for all API calls.
# Point this at the running Express backend (default port 5000).
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# WebSocket endpoint — used for Socket.io real-time notifications (Phase 3).
# Must match the same host/port as the backend HTTP server.
NEXT_PUBLIC_WS_URL=ws://localhost:5000
